# Địa chỉ website sau khi deploy (để ảnh xem trước Zalo/Facebook có link đầy đủ)
NEXT_PUBLIC_SITE_URL=https://linhanhthaihungwedding.cloud

# URL Web App của Google Apps Script để lưu phản hồi vào Google Sheet (xem README)
RSVP_WEBHOOK_URL=

# Lưu trữ Sổ lưu bút bền vững qua Upstash Redis (Vercel Marketplace)
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Mật khẩu quản trị Sổ lưu bút (/admin/wishes)
ADMIN_PASSWORD=your_secure_admin_password
