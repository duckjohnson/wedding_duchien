# =====================================================================
# BIẾN MÔI TRƯỜNG – SAO CHÉP THÀNH .env.local VÀ ĐIỀN GIÁ TRỊ THẬT
# Trên Vercel: Settings → Environment Variables → thêm từng biến bên dưới
# =====================================================================

# ── BẮT BUỘC ─────────────────────────────────────────────────────────
# Địa chỉ website Production (để og:image và canonical dùng đúng tên miền)
# → Vercel: đặt cho Environment = Production
NEXT_PUBLIC_SITE_URL=https://linhanhthaihungwedding.com

# ── REDIS (Sổ lưu bút) ───────────────────────────────────────────────
# Tạo database tại https://console.upstash.com → "Redis" → Copy 2 giá trị sau
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ── RSVP webhook (Google Sheets) ─────────────────────────────────────
# Deploy Google Apps Script rồi dán URL Web App vào đây (có thể để trống)
RSVP_WEBHOOK_URL=

# ── ADMIN ────────────────────────────────────────────────────────────
# Mật khẩu đăng nhập trang /admin/wishes
ADMIN_PASSWORD=your_secure_admin_password
